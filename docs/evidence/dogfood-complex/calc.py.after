class DivByZero(Exception):
    """Raised when the divisor is zero."""


class EmptySequence(Exception):
    """Raised when a sequence is empty where at least one element is required."""


def _to_number(x):
    if isinstance(x, str):
        return float(x)
    return x


def add(a, b):
    return _to_number(a) + _to_number(b)


def div(a, b):
    if b == 0:
        raise DivByZero("division by zero")
    return a / b


def mean(seq):
    values = list(seq)
    if not values:
        raise EmptySequence("mean of empty sequence")
    return sum(values) / len(values)
