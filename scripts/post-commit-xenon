#!/usr/bin/env bash
#
# Git Post-Commit Hook - 检查 CI 状态
#
# 在每次 commit 后自动检查 CI 测试是否通过。
# 如果 CI 失败，显示错误并提供修复选项。

set -e

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 获取当前分支
BRANCH=$(git rev-parse --abbrev-ref HEAD)
COMMIT_SHA=$(git rev-parse HEAD)

echo -e "${BLUE}[CI Hook]${NC} 检测到新提交: ${COMMIT_SHA:0:8}"

# 检查是否有远程仓库
if ! git remote -v | grep -q "origin"; then
    echo -e "${YELLOW}[CI Hook]${NC} 没有远程仓库，跳过 CI 检查"
    exit 0
fi

# 检查 gh CLI 是否可用
if ! command -v gh &> /dev/null; then
    echo -e "${YELLOW}[CI Hook]${NC} gh CLI 未安装，跳过 CI 检查"
    exit 0
fi

# 检查是否推送到远程（通过检查最后一次推送的提交）
LAST_PUSHED=$(git rev-parse origin/$BRANCH 2>/dev/null || echo "")
if [ "$LAST_PUSHED" != "$COMMIT_SHA" ]; then
    echo -e "${YELLOW}[CI Hook]${NC} 提交尚未推送，请先推送: git push"
    exit 0
fi

# 等待 CI 开始（最多 30 秒）
echo -e "${BLUE}[CI Hook]${NC} 等待 CI 启动..."
MAX_WAIT=30
WAITED=0

while [ $WAITED -lt $MAX_WAIT ]; do
    # 获取最新的 CI 运行
    LATEST_RUN=$(gh run list --branch "$BRANCH" --limit 1 --json databaseId,headSha,status,conclusion 2>/dev/null || echo "")

    if [ -n "$LATEST_RUN" ]; then
        RUN_SHA=$(echo "$LATEST_RUN" | jq -r '.[0].headSha' 2>/dev/null || echo "")

        # 检查是否是当前提交的 CI
        if [ "$RUN_SHA" = "$COMMIT_SHA" ]; then
            RUN_ID=$(echo "$LATEST_RUN" | jq -r '.[0].databaseId')
            echo -e "${GREEN}[CI Hook]${NC} CI 已启动 (Run ID: $RUN_ID)"
            break
        fi
    fi

    sleep 2
    WAITED=$((WAITED + 2))
done

if [ $WAITED -ge $MAX_WAIT ]; then
    echo -e "${YELLOW}[CI Hook]${NC} CI 未在 ${MAX_WAIT}s 内启动"
    exit 0
fi

# 等待 CI 完成（最多 5 分钟）
echo -e "${BLUE}[CI Hook]${NC} 等待 CI 完成（最多 5 分钟）..."
MAX_WAIT=300
WAITED=0

while [ $WAITED -lt $MAX_WAIT ]; do
    RUN_INFO=$(gh run view "$RUN_ID" --json status,conclusion 2>/dev/null || echo "{}")
    STATUS=$(echo "$RUN_INFO" | jq -r '.status' 2>/dev/null || echo "unknown")
    CONCLUSION=$(echo "$RUN_INFO" | jq -r '.conclusion' 2>/dev/null || echo "")

    if [ "$STATUS" = "completed" ]; then
        echo ""
        if [ "$CONCLUSION" = "success" ]; then
            echo -e "${GREEN}[CI Hook] ✓${NC} CI 测试通过！"
            exit 0
        else
            echo -e "${RED}[CI Hook] ✗${NC} CI 测试失败！"
            echo ""

            # 显示失败的作业
            echo -e "${YELLOW}失败的测试：${NC}"
            gh run view "$RUN_ID" --log-failed 2>&1 | head -50

            echo ""
            echo -e "${YELLOW}修复选项：${NC}"
            echo "1. 查看完整日志: gh run view $RUN_ID --log-failed"
            echo "2. 在浏览器中查看: gh run view $RUN_ID --web"
            echo "3. 运行本地 Ruff: ruff check xenon tests evals --fix"
            echo ""

            exit 1
        fi
    fi

    # 显示进度
    printf "\r${BLUE}[CI Hook]${NC} CI 运行中... ${WAITED}s / ${MAX_WAIT}s"

    sleep 10
    WAITED=$((WAITED + 10))
done

echo ""
echo -e "${YELLOW}[CI Hook]${NC} CI 运行时间超过 5 分钟，请手动检查"
echo "运行: gh run view $RUN_ID"
exit 0
