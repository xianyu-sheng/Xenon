#!/bin/bash
# Xenon 自动安装 Hook (增强版)
#
# 功能：
# 1. 每次提交后自动安装最新版本
# 2. 跨会话复用项目级虚拟环境
# 3. 智能缓存（仅在代码变更时重新安装）
# 4. 并发安全（文件锁）
#
# 使用：
#   安装: ln -s ../../scripts/post-commit-xenon .git/hooks/post-commit
#   手动触发: .git/hooks/post-commit
#   激活环境: source .xenon-venv/bin/activate

set -e

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
VENV_DIR="$PROJECT_ROOT/.xenon-venv"
LOCK_FILE="$PROJECT_ROOT/.xenon-install.lock"
VERSION_FILE="$VENV_DIR/.xenon-version"
PYTHON="${PYTHON:-python3}"

# 颜色输出
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() {
    echo -e "${BLUE}[Xenon Hook]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[Xenon Hook] ✓${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[Xenon Hook] ⚠${NC} $1"
}

log_error() {
    echo -e "${RED}[Xenon Hook] ✗${NC} $1"
}

# 获取当前 commit hash
CURRENT_COMMIT=$(git rev-parse HEAD)

# 检查是否需要安装
need_install() {
    # 虚拟环境不存在
    if [ ! -d "$VENV_DIR" ]; then
        return 0
    fi

    # 版本文件不存在
    if [ ! -f "$VERSION_FILE" ]; then
        return 0
    fi

    # 检查是否有 xenon/ 目录的变更
    LAST_COMMIT=$(cat "$VERSION_FILE" 2>/dev/null || echo "")
    if [ "$LAST_COMMIT" != "$CURRENT_COMMIT" ]; then
        # 检查 xenon/ 或 pyproject.toml 是否有变更
        if git diff --quiet "$LAST_COMMIT" "$CURRENT_COMMIT" -- xenon/ pyproject.toml setup.py 2>/dev/null; then
            log_info "代码未变更，跳过安装"
            return 1
        else
            log_info "检测到代码变更，需要重新安装"
            return 0
        fi
    fi

    return 1
}

# 文件锁（防止并发安装）
acquire_lock() {
    local timeout=30
    local waited=0

    while [ $waited -lt $timeout ]; do
        if mkdir "$LOCK_FILE" 2>/dev/null; then
            trap "rm -rf '$LOCK_FILE'" EXIT
            return 0
        fi
        log_warn "等待其他安装进程... ($waited/$timeout)"
        sleep 1
        waited=$((waited + 1))
    done

    log_error "获取锁超时，可能有其他安装进程挂起"
    log_info "可以手动删除: rm -rf $LOCK_FILE"
    return 1
}

# 主逻辑
main() {
    log_info "检测到新提交: ${CURRENT_COMMIT:0:8}"

    # 检查是否需要安装
    if ! need_install; then
        log_success "Xenon 已是最新版本 (跨会话复用)"
        if [ -d "$VENV_DIR" ]; then
            log_info "激活: source $VENV_DIR/bin/activate"
        fi
        exit 0
    fi

    # 获取文件锁
    if ! acquire_lock; then
        exit 1
    fi

    # 创建虚拟环境
    if [ ! -d "$VENV_DIR" ]; then
        log_info "创建项目级虚拟环境: $VENV_DIR"
        $PYTHON -m venv "$VENV_DIR"
    fi

    # 激活虚拟环境
    source "$VENV_DIR/bin/activate"

    # 升级 pip（静默）
    pip install -q --upgrade pip 2>&1 | grep -v "already satisfied" || true

    # 安装 Xenon（可编辑模式，支持开发）
    log_info "安装 Xenon (可编辑模式)..."
    if pip install -q -e "$PROJECT_ROOT" 2>&1 | tee /tmp/xenon-install.log | grep -E "ERROR|error:"; then
        log_error "安装失败，查看日志: /tmp/xenon-install.log"
        deactivate 2>/dev/null || true
        exit 1
    fi

    # 验证安装
    INSTALLED_VERSION=$(python -c "import xenon; print(xenon.__version__)" 2>/dev/null || echo "未知")

    if [ "$INSTALLED_VERSION" != "未知" ]; then
        # 记录当前 commit
        echo "$CURRENT_COMMIT" > "$VERSION_FILE"

        log_success "Xenon $INSTALLED_VERSION 已安装"
        log_info "虚拟环境: $VENV_DIR"
        log_info "激活命令: source $VENV_DIR/bin/activate"
        log_info "运行命令: xenon"

        # 显示安装位置
        XENON_BIN=$(which xenon 2>/dev/null || echo "未找到")
        if [ "$XENON_BIN" != "未找到" ]; then
            log_info "可执行文件: $XENON_BIN"
        fi
    else
        log_error "安装失败，无法导入 xenon 模块"
        deactivate 2>/dev/null || true
        exit 1
    fi

    deactivate 2>/dev/null || true
}

# 运行主逻辑
main "$@"
